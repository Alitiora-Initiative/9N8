//@version=6
indicator("9N8 Research Signals", overlay=true, max_labels_count=250)
fastLen = input.int(20, "Fast EMA", minval=2)
slowLen = input.int(50, "Slow EMA", minval=3)
atrLen = input.int(14, "ATR period", minval=2)
riskAtr = input.float(2.0, "ATR stop multiplier", minval=0.1)
fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)
atrValue = ta.atr(atrLen)
vwapValue = ta.vwap(hlc3)
[bbMid, bbUpper, bbLower] = ta.bb(close, 20, 2.0)
longSignal = ta.crossover(fast, slow) and close > vwapValue
shortSignal = ta.crossunder(fast, slow) and close < vwapValue
plot(fast, "Fast EMA")
plot(slow, "Slow EMA")
plot(vwapValue, "VWAP")
plot(bbUpper, "Bollinger Upper", color=color.new(color.blue, 60))
plot(bbLower, "Bollinger Lower", color=color.new(color.blue, 60))
plotshape(longSignal, title="Research long", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(shortSignal, title="Research short", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny)
alertcondition(longSignal, "9N8 Long Research Signal", "Research-only long condition")
alertcondition(shortSignal, "9N8 Short Research Signal", "Research-only short condition")
plot(close - atrValue * riskAtr, "ATR Long Stop", display=display.data_window)
plot(close + atrValue * riskAtr, "ATR Short Stop", display=display.data_window)
