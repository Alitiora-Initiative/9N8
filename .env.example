# 9N8 Solana Telegram bot — safe defaults. Never commit your real .env file.
# Deployed Vercel API and Daemon runtimes require the same Neon DATABASE_URL.
DATABASE_URL=
N9N8_REQUIRE_POSTGRES=false
# Vercel Queue control channel. The Daemon receives VERCEL_OIDC_TOKEN from its runtime
# (or use VERCEL_QUEUE_API_TOKEN only if Vercel explicitly provisions a valid OIDC token).
VERCEL_QUEUE_REGION=iad1
VERCEL_QUEUE_TOPIC=9n8-worker
VERCEL_QUEUE_CONSUMER=n9n8-daemon
# Secret shared by the Vercel API service and Daemon over a private service binding.
N9N8_WORKER_BRIDGE_SECRET=

TELEGRAM_BOT_TOKEN=

# Helius secret is read only from the application runtime environment.
# Add this same name to your deployment provider's environment variables.
HELIUS_API_KEY=
# Optional explicit endpoints override the Helius-derived defaults.
SOLANA_RPC_URL=
SOLANA_WSS_URL=

# Required public Solana address controlled by the platform operator.
MASTER_TREASURY_ADDRESS=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes encrypted wallet records unrecoverable.
ENCRYPTION_MASTER_KEY=

# Paper mode is the default. Live execution requires BOTH switches below.
N9N8_TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# Jupiter Swap API v2. API key may be required for higher request quotas.
JUPITER_API_BASE_URL=https://api.jup.ag/swap/v2
JUPITER_API_KEY=

# Pyth Hermes is public; optional API token if your account provides one.
PYTH_API_KEY=

# Jito Block Engine mainnet endpoint.
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# Mini App: must be the HTTPS URL exposed by the running server.
WEBAPP_URL=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# SQLite is for local development only. Deployed API/worker must use Neon PostgreSQL.
N9N8_DATABASE_PATH=data/9n8-solana.sqlite3
N9N8_MAX_USERS=100
N9N8_MAX_POSITION_SOL=0.50
N9N8_DEFAULT_BUY_SOL=0.05
N9N8_DEFAULT_DAILY_TRADES=5
LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=info

# Optional fallback/override endpoints (set both if not using HELIUS_API_KEY).
# SOLANA_RPC_URL=https://your-rpc-endpoint
# SOLANA_WSS_URL=wss://your-websocket-endpoint
