# 9N8 runs as a cloud worker. Use your hosting provider's secret/environment UI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Optional Twelve Data scanner key.
TWELVEDATA_API_KEY=

# 9N8 is paper-only in this release. Do not change.
MODE=paper
WATCHLIST=XAU/USD,EUR/USD,GBP/USD,USD/JPY,XAG/USD
TIMEFRAME=15min
OUTPUT_SIZE=80

# MT5 provider: metaapi is the cross-device/cloud option; desktop is optional Windows-only.
MT5_PROVIDER=metaapi
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
# Defaults below are MetaApi New York region endpoints. Change only to the URLs
# shown in your MetaApi account/API access page if your account uses another region.
METAAPI_API_BASE=https://mt-client-api-v1.new-york.agiliumtrade.ai
METAAPI_MARKET_DATA_BASE=https://mt-market-data-client-api-v1.new-york.agiliumtrade.ai

# Optional local Windows-only MT5 desktop connector (MT5_PROVIDER=desktop).
MT5_TERMINAL_PATH=
MT5_TIMEFRAME=M15
MT5_BARS=120
MT5_SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY,XAGUSD

# Persistent disk/volume must be mounted at /app/data in cloud hosting.
PAPER_DB_PATH=/app/data/9n8_paper.sqlite3
PAPER_INITIAL_BALANCE=10000
PAPER_CURRENCY=USD
PAPER_MAX_LOTS=0.10
PAPER_MAX_OPEN_POSITIONS=3
PAPER_SLIPPAGE_POINTS=2
PAPER_MAX_TICK_AGE_SECONDS=900
PAPER_DEFAULT_SL_POINTS=500
PAPER_DEFAULT_TP_POINTS=1000
PAPER_DEFAULT_BE_TRIGGER_POINTS=150
PAPER_DEFAULT_BE_OFFSET_POINTS=0

# Scheduled weekly aggregate P&L community report (Monday 09:00 UTC by default).
# Users must explicitly opt in with /share_stats on before their data is included.
REPORT_DAY=MON
REPORT_TIME=09:00
REPORT_TIMEZONE=UTC
