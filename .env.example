# Copy to .env. Never commit this file or paste its values into chat.
TRADING_MODE=paper
LIVE_TRADING=false
ALLOW_LIVE_TRADING=false
LIVE_ACKNOWLEDGEMENT=
LIVE_EXECUTION_CERTIFIED=false

# CEX keys: use dedicated spot/testnet keys, no withdrawals/transfers, IP restrictions.
CEX_API_KEY=
CEX_API_SECRET=
CEX_PASSWORD=

# Alpaca market data only. The stock connector does not place live orders.
# IEX feed is the default; SIP/delayed feeds depend on your Alpaca subscription.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_FEED=iex

# OANDA v20 (practice by default)
OANDA_ENVIRONMENT=practice
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=

# Solana/EVM: data providers only in this release. Do not store wallet seed phrases
# or signing keys in Telegram, GitHub, or .env. Live DEX signing is certification-locked.
SOLANA_RPC_URL=https://api.devnet.solana.com
JUPITER_API_KEY=
BIRDEYE_API_KEY=

EVM_RPC_URL=
EVM_CHAIN_ID=1
ZEROX_API_KEY=
GOPLUS_ACCESS_TOKEN=
ALLOW_LIVE_DEX_EXECUTION=false

# Telegram: comma-separated numeric user IDs; empty means controller disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Private dashboard API. Generate a fresh random token and keep it in .env only.
# Minimum 24h spot quote volume in quote/USD terms; missing volume blocks new crypto entries.
MINIMUM_24H_QUOTE_VOLUME_USD=100000
PAPER_MAX_HOLD_MINUTES=240
PAPER_MIN_STAGNATION_PROFIT_PCT=1.0

DASHBOARD_API_TOKEN=
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=8787
DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_PATH=data/9n8_trades.sqlite3
LOG_LEVEL=INFO

# Telegram-controlled trade approval (all entries require an explicit owner decision)
# Proposals expire after 120 seconds and are rejected if the executable quote moves >0.50%.
