# 9N8 is a private, owner-only Telegram bot. Never commit your real .env file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Your own OKX API credentials.
# Create an OKX DEMO API key first. Keep Withdraw permission OFF.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# DEMO is the safe default. Use the domain for your own OKX account region.
OKX_API_BASE=https://www.okx.com
OKX_TRADING_MODE=demo

# Live order submission is separately locked. Leave false while testing.
OKX_LIVE_TRADING_ENABLED=false

# Hard per-order notional cap in the instrument quote currency (e.g. USDT for BTC-USDT).
OKX_MAX_ORDER_NOTIONAL=10


# --- 9N8 paper trading (live OKX prices; simulated money only) ---
PAPER_DB_PATH=data/9n8_paper.sqlite3
PAPER_QUOTE_CURRENCY=USDT
PAPER_INITIAL_BALANCE=1000
PAPER_WATCHLIST=BTC-USDT,ETH-USDT,SOL-USDT
PAPER_TIMEFRAME=5m
PAPER_SCAN_INTERVAL_SECONDS=60
PAPER_MONITOR_INTERVAL_SECONDS=5

# Entry quality filters. OKX volCcy24h is quote-currency volume for SPOT instruments.
PAPER_MIN_24H_QUOTE_VOLUME=50000
PAPER_MAX_SPREAD_BPS=80
PAPER_MAX_QUOTE_AGE_SECONDS=20

# Conservative configurable paper risk model.
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_BPS=5
PAPER_RISK_PER_TRADE_PCT=1
PAPER_MAX_POSITION_PCT=20
PAPER_DAILY_LOSS_LIMIT_PCT=3
PAPER_MAX_OPEN_POSITIONS=3
PAPER_HARD_STOP_LOSS_PCT=5
PAPER_TP1_TARGET_PCT=10
PAPER_TP1_CLOSE_PCT=50
PAPER_TRAILING_ACTIVATION_PCT=8
PAPER_TRAILING_STOP_PCT=4
PAPER_MAX_HOLD_MINUTES=240
PAPER_STAGNATION_PROFIT_PCT=1
